# Copy this file to .env (same directory as the scripts) and fill in real values.
# .env is sourced automatically by cml-lab.sh / docker-lab.sh if present.
# chmod 600 .env once filled in -- it contains your CML (and optionally SSH) password.

# --- CML server ---
CML_HOST=10.10.10.20
CML_USER=your_cml_username
CML_PASS=your_cml_password
CML_LAB_PREFIX="CCIE Automation"

# --- Docker host  ---
LAB_INFRA_DIR=/home/user/code/ccie_automation/lab_infra
LAB_HOST=10.10.10.10
LAB_USER=your_host_username
# Optional: SSH password for LAB_USER. If set, docker-lab.sh uses password auth
# (needs sshpass) instead of SSH keys.
#LAB_PASS=your_ssh_password
