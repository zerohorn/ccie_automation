# Copy to .env and set real values. .env is gitignored — never commit it.
# NOTE: grafana/datasources/influxdb.yml has its own copy of INFLUXDB_ADMIN_TOKEN
# and INFLUXDB_BUCKET below — Grafana's provisioning file doesn't read this .env,
# so keep the two in sync by hand when you change either one.

INFLUXDB_USERNAME=expert
INFLUXDB_PASSWORD=change_me_strong_password
INFLUXDB_ORG=CCIEAutomation
INFLUXDB_BUCKET=CCIEAutomation
INFLUXDB_ADMIN_TOKEN=change_me_long_random_token

GRAFANA_ADMIN_USER=expert
GRAFANA_ADMIN_PASSWORD=change_me_strong_password
